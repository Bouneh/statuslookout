        <TextBlock Text="{DynamicResource Ui040}" Foreground="{DynamicResource Palette41}" FontSize="11" Margin="0,10,0,12"/>
        <CheckBox Content="{DynamicResource Ui041}" IsChecked="{Binding NotifyOutage}"/>
        <CheckBox Content="{DynamicResource Ui042}" IsChecked="{Binding NotifyDegraded}"/>
