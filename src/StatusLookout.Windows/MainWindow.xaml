<Window x:Class="StatusLookout.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource Ui000}" Width="1180" Height="820" MinWidth="940" MinHeight="670" WindowStartupLocation="CenterScreen" Background="{DynamicResource Palette0}" Foreground="{DynamicResource Palette1}" FontFamily="Segoe UI" WindowStyle="None" ResizeMode="CanResize" Closing="OnClosing">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/></WindowChrome.WindowChrome>
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Palette1}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="SmallLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Palette2}"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="{DynamicResource Palette3}"/><Setter Property="Background" Value="{DynamicResource Palette4}"/><Setter Property="BorderBrush" Value="{DynamicResource Palette5}"/>
   <Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="{DynamicResource Palette6}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Nav" TargetType="ToggleButton">
   <Setter Property="Margin" Value="0,4"/><Setter Property="Padding" Value="16,13"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Foreground" Value="{DynamicResource Palette7}"/><Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Palette8}"/><Setter Property="Foreground" Value="{DynamicResource Palette9}"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="{DynamicResource Palette10}"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="{DynamicResource Palette11}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,8"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal">
    <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" BorderBrush="{DynamicResource Palette12}" BorderThickness="1" Background="{DynamicResource Palette13}" VerticalAlignment="Center"><TextBlock x:Name="Mark" Text="✓" Foreground="{DynamicResource Palette14}" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Border>
    <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
   </StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="{DynamicResource Palette15}"/><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Palette16}"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource Palette17}"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBox"><Setter Property="Foreground" Value="{DynamicResource Palette1}"/></Style>
  <Style TargetType="Thumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="{DynamicResource Palette18}" CornerRadius="5" Margin="2"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="{DynamicResource Palette1}"/><Setter Property="Background" Value="{DynamicResource Palette19}"/><Setter Property="BorderBrush" Value="{DynamicResource Palette5}"/><Setter Property="Padding" Value="12,10"/><Setter Property="CaretBrush" Value="{DynamicResource Palette20}"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="{DynamicResource Palette21}"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="{DynamicResource Palette22}"/><Setter Property="BorderBrush" Value="{DynamicResource Palette23}"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/></Style>
 </Window.Resources>
 <Border BorderThickness="1" BorderBrush="{DynamicResource Palette24}">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Background="{DynamicResource Palette25}">
   <TextBlock Text="{DynamicResource Ui001}" Foreground="{DynamicResource Palette26}" FontSize="10" FontWeight="SemiBold" Margin="20,0" VerticalAlignment="Center"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
    <Button Content="—" Width="48" Background="Transparent" BorderBrush="Transparent" Click="MinimizeClick" AutomationProperties.Name="{DynamicResource Ui002}"/>
    <Button Content="□" Width="48" Background="Transparent" BorderBrush="Transparent" Click="MaximizeClick" AutomationProperties.Name="{DynamicResource Ui003}"/>
    <Button Content="×" Width="48" Background="Transparent" BorderBrush="Transparent" FontSize="19" Click="HideClick" AutomationProperties.Name="{DynamicResource Ui004}"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="{DynamicResource Palette27}" BorderBrush="{DynamicResource Palette23}" BorderThickness="0,0,1,0" Padding="18,26,18,22">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel>
      <StackPanel Orientation="Horizontal">
       <Viewbox Width="30" Height="30" Margin="0,0,9,0"><Canvas Width="32" Height="32"><Ellipse Width="27" Height="27" Canvas.Left="2.5" Canvas.Top="2.5" Stroke="#6E9AFF" StrokeThickness="3"/><Path Data="M16,16 L25,7" Stroke="#6E9AFF" StrokeThickness="3" StrokeStartLineCap="Round" StrokeEndLineCap="Round"/><Ellipse Width="7" Height="7" Canvas.Left="12.5" Canvas.Top="12.5" Fill="#25B990"/><Ellipse Width="6" Height="6" Canvas.Left="23" Canvas.Top="5" Fill="#25B990"/></Canvas></Viewbox>
       <TextBlock Text="StatusLookout" FontWeight="Bold" FontSize="18" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="{DynamicResource Ui005}" Style="{StaticResource SmallLabel}" FontSize="9" Margin="0,16,0,28"/>
     </StackPanel>
     <StackPanel Grid.Row="1" x:Name="Navigation">
      <ToggleButton Style="{StaticResource Nav}" Tag="Watch" IsChecked="True" Click="NavigateClick" Content="{DynamicResource Ui006}"/>
      <ToggleButton Style="{StaticResource Nav}" Tag="Library" Click="NavigateClick" Content="{DynamicResource Ui007}"/>
      <ToggleButton Style="{StaticResource Nav}" Tag="Activity" Click="NavigateClick" Content="{DynamicResource Ui008}"/>
      <ToggleButton Style="{StaticResource Nav}" Tag="Settings" Click="NavigateClick" Content="{DynamicResource Ui009}"/>
     </StackPanel>
     <StackPanel Grid.Row="3">
      <Border Background="{DynamicResource Palette29}" CornerRadius="10" Padding="13">
       <StackPanel><TextBlock Text="{DynamicResource Ui010}" FontWeight="SemiBold" Margin="0,0,0,6"/><TextBlock Text="{DynamicResource Ui011}" Foreground="{DynamicResource Palette2}" FontSize="11" LineHeight="18"/></StackPanel>
      </Border>
      <TextBlock Text="{DynamicResource Ui012}" Style="{StaticResource SmallLabel}" FontSize="9" Margin="4,18,0,0"/>
      <Button Content="{DynamicResource Ui013}" Margin="0,10,0,0" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource Palette30}" Click="GitHubClick"/>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Column="1" Margin="28,24,28,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock x:Name="PageTitle" Text="{DynamicResource Ui014}" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="{Binding SyncLabel}" Foreground="{DynamicResource Palette2}" FontSize="12" Margin="0,7,0,0"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{Binding PauseLabel}" Click="PauseClick" Margin="0,0,8,0"/><Button Content="{Binding RefreshLabel}" Click="RefreshClick" Foreground="#FFFFFF" Background="{DynamicResource Palette15}" BorderBrush="{DynamicResource Palette31}"/></StackPanel>
    </Grid>
    <Border Grid.Row="1" Background="{DynamicResource Palette32}" BorderBrush="{DynamicResource Palette33}" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,14" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}">
     <DockPanel><Button Content="×" DockPanel.Dock="Right" Padding="8,2" Click="DismissClick"/><TextBlock Text="{Binding ErrorMessage}" Foreground="{DynamicResource Palette34}" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/></DockPanel>
    </Border>
    <Grid Grid.Row="2">
     <Grid x:Name="WatchPage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Panel}" Background="{DynamicResource Palette35}" Padding="22" Margin="0,0,0,16">
       <StackPanel><TextBlock Text="{DynamicResource Ui015}" Foreground="{DynamicResource Palette16}" FontSize="10" FontWeight="Bold" Margin="0,0,0,12"/>
        <TextBlock Text="{Binding OverallTitle}" FontSize="23" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding OverallDescription}" Foreground="{DynamicResource Palette36}" FontSize="12" Margin="0,10,0,0" LineHeight="19"/>
       </StackPanel>
      </Border>
      <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,-10,18">
       <Border Style="{StaticResource Panel}" Margin="0,0,10,0" Padding="16,12"><StackPanel><TextBlock Text="{DynamicResource Ui016}" Style="{StaticResource SmallLabel}"/><TextBlock Text="{Binding WatchedCount}" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Panel}" Margin="0,0,10,0" Padding="16,12"><StackPanel><TextBlock Text="{DynamicResource Ui017}" Style="{StaticResource SmallLabel}"/><TextBlock Text="{Binding HealthyCount}" Foreground="{DynamicResource Palette37}" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Panel}" Margin="0,0,10,0" Padding="16,12"><StackPanel><TextBlock Text="{DynamicResource Ui018}" Style="{StaticResource SmallLabel}"/><TextBlock Text="{Binding IssueCount}" Foreground="{DynamicResource Palette38}" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Panel}" Margin="0,0,10,0" Padding="16,12"><StackPanel><TextBlock Text="{DynamicResource Ui019}" Style="{StaticResource SmallLabel}"/><TextBlock Text="{Binding UnknownCount}" Foreground="{DynamicResource Palette2}" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
      </UniformGrid>
      <Grid Grid.Row="2">
       <TextBlock Text="{DynamicResource Ui020}" Foreground="{DynamicResource Palette2}" Margin="20" Visibility="{Binding IsWatchlistEmpty, Converter={StaticResource BoolVisibility}}"/>
       <ListBox ItemsSource="{Binding Watchlist}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
        <ListBox.ItemTemplate><DataTemplate>
         <Border Style="{StaticResource Panel}" Padding="17,14">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="122"/></Grid.ColumnDefinitions>
           <Border Background="{Binding StatusBackground}" Width="32" Height="32" CornerRadius="9" VerticalAlignment="Top"><TextBlock Text="{Binding Initials}" Foreground="{Binding StatusBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
           <StackPanel Grid.Column="1" Margin="0,0,18,0">
            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Category}" Foreground="{DynamicResource Palette39}" FontSize="10" Margin="10,4,0,0"/></StackPanel>
            <TextBlock Text="{Binding Message}" Foreground="{DynamicResource Palette40}" FontSize="12" Margin="0,6,0,0" MaxHeight="54" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding LastConfirmed}" Foreground="{DynamicResource Palette38}" FontSize="11" Margin="0,3,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,7,0,0"><TextBlock Text="{Binding CheckedLabel}" Foreground="{DynamicResource Palette41}" FontSize="10" VerticalAlignment="Center"/><CheckBox Content="{DynamicResource Ui021}" IsChecked="{Binding IsMuted}" FontSize="10" Margin="15,0,0,0"/></StackPanel>
           </StackPanel>
           <StackPanel Grid.Column="2" HorizontalAlignment="Right">
            <Border Background="{Binding StatusBackground}" CornerRadius="6" Padding="10,4"><StackPanel Orientation="Horizontal"><Ellipse Fill="{Binding StatusBrush}" Width="6" Height="6" Margin="0,0,7,0"/><TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusBrush}" FontSize="10" FontWeight="SemiBold"/></StackPanel></Border>
            <Button Content="{DynamicResource Ui022}" Tag="{Binding}" Click="OpenServiceClick" Margin="0,8,0,0" Padding="8,4" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource Palette42}" FontSize="10"/>
            <Button Content="{DynamicResource Ui023}" Tag="{Binding}" Click="RemoveServiceClick" Padding="8,2" Background="Transparent" BorderBrush="Transparent" Foreground="{DynamicResource Palette41}" FontSize="10"/>
           </StackPanel>
          </Grid>
         </Border>
        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </Grid>
     </Grid>

     <Grid x:Name="LibraryPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="{Binding CatalogDescription}" Foreground="{DynamicResource Palette2}" FontSize="13" Margin="0,0,0,18"/>
      <Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="{DynamicResource Ui024}" ToolTip="{DynamicResource Ui025}" Margin="0,0,10,0"/>
       <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Margin="0,0,10,0" AutomationProperties.Name="{DynamicResource Ui026}"/>
       <Button Grid.Column="2" Content="{DynamicResource Ui027}" Click="CustomClick"/>
      </Grid>
      <ListBox Grid.Row="2" ItemsSource="{Binding LibraryView}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
       <ListBox.ItemTemplate><DataTemplate>
        <Border Style="{StaticResource Panel}" Padding="14,11">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
          <CheckBox IsChecked="{Binding IsWatched}" AutomationProperties.Name="{Binding Name}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{Binding ProviderLabel}" Foreground="{DynamicResource Palette41}" FontSize="10" Margin="0,5,0,0"/></StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding Category}" Foreground="{DynamicResource Palette2}" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
         </Grid>
        </Border>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Grid>

     <Grid x:Name="ActivityPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,18"><Button DockPanel.Dock="Right" Content="{DynamicResource Ui028}" Click="ClearHistoryClick"/><TextBlock Text="{DynamicResource Ui029}" Foreground="{DynamicResource Palette2}" FontSize="12" VerticalAlignment="Center"/></DockPanel>
      <Grid Grid.Row="1">
       <TextBlock Text="{DynamicResource Ui030}" Foreground="{DynamicResource Palette2}" Margin="20" Visibility="{Binding IsActivityEmpty, Converter={StaticResource BoolVisibility}}"/>
       <ListBox ItemsSource="{Binding Activity}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Panel}" Padding="18,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="128"/></Grid.ColumnDefinitions>
         <Ellipse Fill="{Binding Color}" Width="7" Height="7" VerticalAlignment="Top" Margin="0,5,0,0"/>
         <StackPanel Grid.Column="1" Margin="8,0,20,0"><TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding Message}" Foreground="{DynamicResource Palette2}" FontSize="12" Margin="0,8,0,0"/></StackPanel>
         <TextBlock Grid.Column="2" Text="{Binding Time}" Foreground="{DynamicResource Palette41}" FontSize="10" HorizontalAlignment="Right"/>
        </Grid></Border></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </Grid>
     </Grid>

     <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <Border Style="{StaticResource Panel}" Margin="0,0,0,16"><StackPanel>
        <TextBlock Text="{DynamicResource Ui106}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
         <StackPanel Margin="0,0,14,0"><TextBlock Text="{DynamicResource Ui107}" Margin="0,0,0,6"/><ComboBox SelectedValue="{Binding Language}" SelectedValuePath="Tag" AutomationProperties.Name="{DynamicResource Ui107}"><ComboBoxItem Content="English" Tag="en"/><ComboBoxItem Content="Français" Tag="fr"/></ComboBox></StackPanel>
         <StackPanel Grid.Column="1"><TextBlock Text="{DynamicResource Ui108}" Margin="0,0,0,6"/><ComboBox SelectedValue="{Binding Theme}" SelectedValuePath="Tag" AutomationProperties.Name="{DynamicResource Ui108}"><ComboBoxItem Content="{DynamicResource Ui109}" Tag="dark"/><ComboBoxItem Content="{DynamicResource Ui110}" Tag="light"/></ComboBox></StackPanel>
        </Grid><TextBlock Text="{DynamicResource Ui111}" Foreground="{DynamicResource Palette2}" FontSize="11" Margin="0,12,0,0"/>
       </StackPanel></Border>

       <Border Style="{StaticResource Panel}" Margin="0,0,0,16"><StackPanel>
        <TextBlock Text="{DynamicResource Ui031}" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <CheckBox Content="{DynamicResource Ui032}" IsChecked="{Binding LaunchAtLogin}"/>
        <CheckBox Content="{DynamicResource Ui033}" IsChecked="{Binding StartMinimized}"/>
        <TextBlock Text="{DynamicResource Ui034}" Foreground="{DynamicResource Palette41}" FontSize="11" Margin="0,0,0,16"/>
        <StackPanel Orientation="Horizontal"><TextBlock Text="{DynamicResource Ui035}" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox Text="{Binding PollSeconds, UpdateSourceTrigger=LostFocus}" Width="85" AutomationProperties.Name="{DynamicResource Ui036}"/><TextBlock Text="{DynamicResource Ui037}" Foreground="{DynamicResource Palette2}" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
       </StackPanel></Border>
       <Border Style="{StaticResource Panel}" Margin="0,0,0,16"><StackPanel>
        <DockPanel><Button Content="{DynamicResource Ui038}" DockPanel.Dock="Right" Click="TestNotificationClick"/><TextBlock Text="{DynamicResource Ui039}" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
        <TextBlock Text="{DynamicResource Ui040}" Foreground="{DynamicResource Palette41}" FontSize="11" Margin="0,10,0,12"/>
        <CheckBox Content="{DynamicResource Ui041}" IsChecked="{Binding NotifyOutage}"/>
        <CheckBox Content="{DynamicResource Ui042}" IsChecked="{Binding NotifyDegraded}"/>
        <CheckBox Content="{DynamicResource Ui043}" IsChecked="{Binding NotifyRecovery}"/>
        <CheckBox Content="{DynamicResource Ui044}" IsChecked="{Binding NotifyMaintenance}"/>
        <CheckBox Content="{DynamicResource Ui045}" IsChecked="{Binding AlertOnFirstProblem}"/>
        <CheckBox Content="{DynamicResource Ui046}" IsChecked="{Binding NotificationSound}"/>
       </StackPanel></Border>
       <Border Style="{StaticResource Panel}"><StackPanel>
        <TextBlock Text="{DynamicResource Ui047}" FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="{DynamicResource Ui048}" Foreground="{DynamicResource Palette2}" FontSize="12" Margin="0,12,0,0" LineHeight="20"/>
        <Button Content="{DynamicResource Ui049}" HorizontalAlignment="Left" Margin="0,14,0,0" Click="DataFolderClick"/>
       </StackPanel></Border>
      </StackPanel>
     </ScrollViewer>
    </Grid>
    <TextBlock Grid.Row="3" Text="{DynamicResource Ui050}" FontSize="9" Foreground="{DynamicResource Palette43}" Margin="0,16,0,0"/>
   </Grid>
  </Grid>
 </Grid>
 </Border>
</Window>
