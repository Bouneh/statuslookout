          <TextBlock Text="{DynamicResource SoundSettingsHint}" FontSize="11" Foreground="{DynamicResource Palette2}" Margin="0,0,0,12"/>
          <ItemsControl ItemsSource="{Binding SoundEvents}"><ItemsControl.ItemTemplate><DataTemplate><StackPanel Margin="0,0,0,12">
           <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <TextBlock Text="{Binding Label}" VerticalAlignment="Center" FontSize="12"/>
            <ComboBox Grid.Column="1" ItemsSource="{Binding DataContext.SoundChoices,RelativeSource={RelativeSource AncestorType=Window}}" DisplayMemberPath="Label" SelectedValuePath="Key" SelectedValue="{Binding SelectedSound,Mode=TwoWay}" MinWidth="110" Margin="0,0,8,0" AutomationProperties.Name="{Binding Label}"/>
            <Button Grid.Column="2" Content="{DynamicResource PreviewSound}" Click="PreviewSoundClick" Tag="{Binding}" Padding="9,7" Margin="0,0,8,0"/>
            <Button Grid.Column="3" Content="{DynamicResource ImportSound}" Click="ImportSoundClick" Tag="{Binding}" Padding="9,7"/>
           </Grid><TextBlock Text="{Binding CustomSoundName}" FontSize="10" Foreground="{DynamicResource Palette2}" Margin="130,3,0,0" TextTrimming="CharacterEllipsis" MaxHeight="28"/>
          </StackPanel></DataTemplate></ItemsControl.ItemTemplate></ItemsControl>
          <Grid Margin="0,3,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="130"/><ColumnDefinition Width="*"/><ColumnDefinition Width="50"/></Grid.ColumnDefinitions><TextBlock Text="{DynamicResource SoundVolume}" VerticalAlignment="Center"/><Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding NotificationVolume}" VerticalAlignment="Center" AutomationProperties.Name="{DynamicResource SoundVolume}"/><TextBlock Grid.Column="2" Text="{Binding NotificationVolume,StringFormat={}{0:0}%}" HorizontalAlignment="Right" VerticalAlignment="Center"/></Grid>
          <TextBlock Text="{DynamicResource SoundVolumeHint}" FontSize="10" Foreground="{DynamicResource Palette2}" Margin="0,10,0,0"/>
         </StackPanel>
