<Window x:Class="StatusLookout.Windows.ComponentPickerWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="{DynamicResource ComponentsTitle}" Width="600" Height="610" MinWidth="480" MinHeight="400" WindowStartupLocation="CenterOwner" Background="{DynamicResource Palette0}" Foreground="{DynamicResource Palette1}" FontFamily="Segoe UI">
 <Window.Resources>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="{DynamicResource Palette1}"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style TargetType="CheckBox"><Setter Property="Foreground" Value="{DynamicResource Palette1}"/><Setter Property="Margin" Value="8"/></Style>
  <Style TargetType="Button"><Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,8,0"/><Setter Property="Background" Value="{DynamicResource Palette4}"/><Setter Property="Foreground" Value="{DynamicResource Palette3}"/><Setter Property="BorderBrush" Value="{DynamicResource Palette5}"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="12"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button"><Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}"><ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><ControlTemplate.Triggers><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter></Style>
 </Window.Resources>
 <Grid Margin="24"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
  <StackPanel><TextBlock x:Name="ServiceTitle" FontSize="23" FontWeight="SemiBold"/><TextBlock Text="{DynamicResource ComponentsExplanation}" Margin="0,12,0,16" FontSize="12" Foreground="{DynamicResource Palette2}"/></StackPanel>
  <TextBox Grid.Row="1" x:Name="SearchBox" TextChanged="SearchChanged" Padding="10" Margin="0,0,0,12" Background="{DynamicResource Palette22}" Foreground="{DynamicResource Palette1}" CaretBrush="{DynamicResource Palette1}" AutomationProperties.Name="{DynamicResource ComponentSearch}"/>
  <TextBlock Grid.Row="2" x:Name="Feedback" Margin="0,0,0,12" Foreground="{DynamicResource Palette2}"/>
  <ListBox Grid.Row="3" x:Name="Choices" Background="{DynamicResource Palette22}" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
   <ListBox.ItemTemplate><DataTemplate><CheckBox Content="{Binding Name}" IsChecked="{Binding Selected}"/></DataTemplate></ListBox.ItemTemplate>
  </ListBox>
  <WrapPanel Grid.Row="4" Margin="0,16,0,0"><Button Content="{DynamicResource EntirePage}" Click="AllClick"/><Button Content="{DynamicResource CatalogDefault}" Click="DefaultClick"/><Button x:Name="SaveButton" Content="{DynamicResource ApplyComponents}" Click="SaveClick" IsEnabled="False"/><Button Content="{DynamicResource CancelAction}" Click="CancelClick"/></WrapPanel>
 </Grid>
</Window>
