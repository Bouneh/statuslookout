<Window x:Class="UptimeKite.Windows.CustomServiceWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="Add a custom service" Width="530" Height="450" ResizeMode="NoResize" WindowStartupLocation="CenterOwner" Background="#141F33" Foreground="#F1F5FF" FontFamily="Segoe UI">
 <Window.Resources><Style TargetType="TextBox"><Setter Property="Padding" Value="10,8"/><Setter Property="Margin" Value="0,6,0,16"/></Style><Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F1F5FF"/></Style></Window.Resources>
 <StackPanel Margin="26">
  <TextBlock Text="Bring another service on board." FontSize="20" FontWeight="SemiBold" Margin="0,0,0,20"/>
  <TextBlock Text="Service name"/><TextBox x:Name="ServiceName" AutomationProperties.Name="Service name"/>
  <TextBlock Text="Public HTTPS status page"/><TextBox x:Name="StatusUrl" Text="https://" AutomationProperties.Name="Status page URL"/>
  <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="170"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <StackPanel><TextBlock Text="API format"/><ComboBox x:Name="Provider" SelectedIndex="0" Margin="0,8,16,16" Padding="8"><ComboBoxItem Content="Statuspage compatible" Tag="statuspage"/><ComboBoxItem Content="Instatus" Tag="instatus"/></ComboBox></StackPanel>
   <StackPanel Grid.Column="1"><TextBlock Text="Component IDs (optional, comma separated)"/><TextBox x:Name="Components" AutomationProperties.Name="Component IDs"/></StackPanel>
  </Grid>
  <TextBlock x:Name="Feedback" Text="The endpoint is checked before saving." Foreground="#94A4BF" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,18"/>
  <Button x:Name="AddButton" Content="Validate &amp; add service" Padding="14,10" HorizontalAlignment="Right" Click="AddClick"/>
 </StackPanel>
</Window>
