<Window x:Class="UptimeKite.Windows.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="UptimeKite — Cloud service status monitor" Width="1180" Height="820" MinWidth="940" MinHeight="670" WindowStartupLocation="CenterScreen" Background="#0C1220" Foreground="#F1F5FF" FontFamily="Segoe UI" WindowStyle="None" ResizeMode="CanResize" Closing="OnClosing">
 <WindowChrome.WindowChrome><WindowChrome CaptionHeight="42" ResizeBorderThickness="6" CornerRadius="0" GlassFrameThickness="0"/></WindowChrome.WindowChrome>
 <Window.Resources>
  <SolidColorBrush x:Key="Muted" Color="#94A4BF"/>
  <Style TargetType="TextBlock"><Setter Property="Foreground" Value="#F1F5FF"/><Setter Property="TextWrapping" Value="Wrap"/></Style>
  <Style x:Key="SmallLabel" TargetType="TextBlock"><Setter Property="Foreground" Value="#94A4BF"/><Setter Property="FontSize" Value="11"/><Setter Property="FontWeight" Value="SemiBold"/></Style>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#EAF1FF"/><Setter Property="Background" Value="#202C43"/><Setter Property="BorderBrush" Value="#34425B"/>
   <Setter Property="Padding" Value="14,9"/><Setter Property="Cursor" Value="Hand"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="12"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
    <Border x:Name="B" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="{TemplateBinding Padding}">
     <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Border>
    <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="BorderBrush" Value="#749FFC"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter TargetName="B" Property="Opacity" Value=".45"/></Trigger></ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style x:Key="Nav" TargetType="ToggleButton">
   <Setter Property="Margin" Value="0,4"/><Setter Property="Padding" Value="16,13"/><Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Foreground" Value="#A5B3CD"/><Setter Property="Background" Value="Transparent"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
    <Border x:Name="B" Background="{TemplateBinding Background}" CornerRadius="9" Padding="{TemplateBinding Padding}"><ContentPresenter/></Border>
    <ControlTemplate.Triggers>
     <Trigger Property="IsChecked" Value="True"><Setter TargetName="B" Property="Background" Value="#203355"/><Setter Property="Foreground" Value="#AFCBFF"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
     <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="B" Property="Background" Value="#19263E"/></Trigger>
    </ControlTemplate.Triggers>
   </ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="Foreground" Value="#DCE6FB"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="Margin" Value="0,8"/><Setter Property="Cursor" Value="Hand"/>
   <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox"><StackPanel Orientation="Horizontal">
    <Border x:Name="Box" Width="16" Height="16" CornerRadius="4" BorderBrush="#596C8D" BorderThickness="1" Background="#101B2F" VerticalAlignment="Center"><TextBlock x:Name="Mark" Text="✓" Foreground="#E8F1FF" FontSize="12" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/></Border>
    <ContentPresenter Margin="9,0,0,0" VerticalAlignment="Center"/>
   </StackPanel><ControlTemplate.Triggers><Trigger Property="IsChecked" Value="True"><Setter TargetName="Box" Property="Background" Value="#456FE3"/><Setter TargetName="Box" Property="BorderBrush" Value="#82AEFF"/><Setter TargetName="Mark" Property="Visibility" Value="Visible"/></Trigger><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Box" Property="BorderBrush" Value="#B9D2FF"/></Trigger><Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value=".5"/></Trigger></ControlTemplate.Triggers></ControlTemplate></Setter.Value></Setter>
  </Style>
  <Style TargetType="ListBox"><Setter Property="Foreground" Value="#F1F5FF"/></Style>
  <Style TargetType="Thumb"><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Thumb"><Border Background="#374861" CornerRadius="5" Margin="2"/></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="ScrollBar"><Setter Property="Width" Value="10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ScrollBar"><Grid Background="Transparent"><Track x:Name="PART_Track" Orientation="{TemplateBinding Orientation}" IsDirectionReversed="True"><Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton><Track.Thumb><Thumb/></Track.Thumb><Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton></Track></Grid></ControlTemplate></Setter.Value></Setter></Style>
  <Style TargetType="TextBox"><Setter Property="Foreground" Value="#F1F5FF"/><Setter Property="Background" Value="#131F34"/><Setter Property="BorderBrush" Value="#34425B"/><Setter Property="Padding" Value="12,10"/><Setter Property="CaretBrush" Value="#8DB7FF"/><Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="ComboBox"><Setter Property="Foreground" Value="#101B2D"/><Setter Property="Padding" Value="10,8"/><Setter Property="FontSize" Value="13"/></Style>
  <Style TargetType="ListBoxItem"><Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Padding" Value="0"/><Setter Property="Margin" Value="0,0,0,10"/><Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter/></ControlTemplate></Setter.Value></Setter></Style>
  <Style x:Key="Panel" TargetType="Border"><Setter Property="Background" Value="#141F33"/><Setter Property="BorderBrush" Value="#25334B"/><Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="12"/><Setter Property="Padding" Value="20"/></Style>
 </Window.Resources>
 <Border BorderThickness="1" BorderBrush="#2D3B53">
 <Grid>
  <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
  <Grid Background="#0B111D">
   <TextBlock Text="UPTIMEKITE   /   SERVICE STATUS MONITOR" Foreground="#7585A1" FontSize="10" FontWeight="SemiBold" Margin="20,0" VerticalAlignment="Center"/>
   <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
    <Button Content="—" Width="48" Background="Transparent" BorderBrush="Transparent" Click="MinimizeClick" AutomationProperties.Name="Minimize"/>
    <Button Content="□" Width="48" Background="Transparent" BorderBrush="Transparent" Click="MaximizeClick" AutomationProperties.Name="Maximize"/>
    <Button Content="×" Width="48" Background="Transparent" BorderBrush="Transparent" FontSize="19" Click="HideClick" AutomationProperties.Name="Close to tray"/>
   </StackPanel>
  </Grid>
  <Grid Grid.Row="1">
   <Grid.ColumnDefinitions><ColumnDefinition Width="205"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
   <Border Background="#10192A" BorderBrush="#25334B" BorderThickness="0,0,1,0" Padding="18,26,18,22">
    <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
     <StackPanel>
      <StackPanel Orientation="Horizontal">
       <Viewbox Width="30" Height="35" Margin="0,0,10,0"><Canvas Width="32" Height="38"><Path Data="M16,1 L30,14 L16,28 L2,14 Z" Fill="#82AEFF"/><Path Data="M16,1 L16,28 L2,14 Z" Fill="#51DCC1"/><Path Data="M16,28 L11,33 L19,37" Stroke="#82AEFF" StrokeThickness="2"/></Canvas></Viewbox>
       <TextBlock Text="UptimeKite" FontWeight="Bold" FontSize="20" VerticalAlignment="Center"/>
      </StackPanel>
      <TextBlock Text="KEEP AN EYE ON YOUR CLOUD." Style="{StaticResource SmallLabel}" FontSize="9" Margin="0,16,0,28"/>
     </StackPanel>
     <StackPanel Grid.Row="1" x:Name="Navigation">
      <ToggleButton Style="{StaticResource Nav}" Tag="Watch" IsChecked="True" Click="NavigateClick" Content="◈   Watchlist"/>
      <ToggleButton Style="{StaticResource Nav}" Tag="Library" Click="NavigateClick" Content="⊞   Service library"/>
      <ToggleButton Style="{StaticResource Nav}" Tag="Activity" Click="NavigateClick" Content="↗   Alert history"/>
      <ToggleButton Style="{StaticResource Nav}" Tag="Settings" Click="NavigateClick" Content="⚙   Preferences"/>
     </StackPanel>
     <StackPanel Grid.Row="3">
      <Border Background="#182840" CornerRadius="10" Padding="13">
       <StackPanel><TextBlock Text="A quiet lookout." FontWeight="SemiBold" Margin="0,0,0,6"/><TextBlock Text="Close this window to keep monitoring from your system tray." Foreground="#94A4BF" FontSize="11" LineHeight="18"/></StackPanel>
      </Border>
      <TextBlock Text="v0.1.0  ·  OPEN SOURCE" Style="{StaticResource SmallLabel}" FontSize="9" Margin="4,18,0,0"/>
      <Button Content="Project on GitHub ↗" Margin="0,10,0,0" Background="Transparent" BorderBrush="Transparent" Foreground="#8EAEDE" Click="GitHubClick"/>
     </StackPanel>
    </Grid>
   </Border>
   <Grid Grid.Column="1" Margin="28,24,28,20">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <Grid Margin="0,0,0,22"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
     <StackPanel><TextBlock x:Name="PageTitle" Text="Your watchlist" FontSize="29" FontWeight="SemiBold"/><TextBlock Text="{Binding SyncLabel}" Foreground="#94A4BF" FontSize="12" Margin="0,7,0,0"/></StackPanel>
     <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center"><Button Content="{Binding PauseLabel}" Click="PauseClick" Margin="0,0,8,0"/><Button Content="{Binding RefreshLabel}" Click="RefreshClick" Background="#456FE3" BorderBrush="#6689F0"/></StackPanel>
    </Grid>
    <Border Grid.Row="1" Background="#382530" BorderBrush="#724456" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,14" Visibility="{Binding HasError, Converter={StaticResource BoolVisibility}}">
     <DockPanel><Button Content="×" DockPanel.Dock="Right" Padding="8,2" Click="DismissClick"/><TextBlock Text="{Binding ErrorMessage}" Foreground="#FFCBD4" FontSize="12" VerticalAlignment="Center" Margin="0,0,10,0"/></DockPanel>
    </Border>
    <Grid Grid.Row="2">
     <Grid x:Name="WatchPage"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Style="{StaticResource Panel}" Background="#172842" Padding="22" Margin="0,0,0,16">
       <StackPanel><TextBlock Text="YOUR SERVICES. ONE CLEAR SIGNAL." Foreground="#82AEFF" FontSize="10" FontWeight="Bold" Margin="0,0,0,12"/>
        <TextBlock Text="{Binding OverallTitle}" FontSize="23" FontWeight="SemiBold"/>
        <TextBlock Text="{Binding OverallDescription}" Foreground="#AABBD6" FontSize="12" Margin="0,10,0,0" LineHeight="19"/>
       </StackPanel>
      </Border>
      <UniformGrid Grid.Row="1" Columns="4" Margin="0,0,-10,18">
       <Border Style="{StaticResource Panel}" Margin="0,0,10,0" Padding="16,12"><StackPanel><TextBlock Text="WATCHING" Style="{StaticResource SmallLabel}"/><TextBlock Text="{Binding WatchedCount}" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Panel}" Margin="0,0,10,0" Padding="16,12"><StackPanel><TextBlock Text="OPERATIONAL" Style="{StaticResource SmallLabel}"/><TextBlock Text="{Binding HealthyCount}" Foreground="#56DCB8" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Panel}" Margin="0,0,10,0" Padding="16,12"><StackPanel><TextBlock Text="NEED ATTENTION" Style="{StaticResource SmallLabel}"/><TextBlock Text="{Binding IssueCount}" Foreground="#FFBD69" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
       <Border Style="{StaticResource Panel}" Margin="0,0,10,0" Padding="16,12"><StackPanel><TextBlock Text="UNAVAILABLE" Style="{StaticResource SmallLabel}"/><TextBlock Text="{Binding UnknownCount}" Foreground="#94A4BF" FontSize="26" FontWeight="SemiBold" Margin="0,6,0,0"/></StackPanel></Border>
      </UniformGrid>
      <Grid Grid.Row="2">
       <TextBlock Text="Your watchlist is empty. Open the service library to choose what matters to you." Foreground="#94A4BF" Margin="20" Visibility="{Binding IsWatchlistEmpty, Converter={StaticResource BoolVisibility}}"/>
       <ListBox ItemsSource="{Binding Watchlist}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True">
        <ListBox.ItemTemplate><DataTemplate>
         <Border Style="{StaticResource Panel}" Padding="17,14">
          <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="122"/></Grid.ColumnDefinitions>
           <Border Background="{Binding StatusBackground}" Width="32" Height="32" CornerRadius="9" VerticalAlignment="Top"><TextBlock Text="{Binding Initials}" Foreground="{Binding StatusBrush}" FontSize="11" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
           <StackPanel Grid.Column="1" Margin="0,0,18,0">
            <StackPanel Orientation="Horizontal"><TextBlock Text="{Binding Name}" FontSize="15" FontWeight="SemiBold"/><TextBlock Text="{Binding Category}" Foreground="#7588A6" FontSize="10" Margin="10,4,0,0"/></StackPanel>
            <TextBlock Text="{Binding Message}" Foreground="#A2B2CD" FontSize="12" Margin="0,6,0,0" MaxHeight="54" TextTrimming="CharacterEllipsis"/>
            <TextBlock Text="{Binding LastConfirmed}" Foreground="#FFBD69" FontSize="11" Margin="0,3,0,0"/>
            <StackPanel Orientation="Horizontal" Margin="0,7,0,0"><TextBlock Text="{Binding CheckedLabel}" Foreground="#71839F" FontSize="10" VerticalAlignment="Center"/><CheckBox Content="Mute alerts" IsChecked="{Binding IsMuted}" FontSize="10" Margin="15,0,0,0"/></StackPanel>
           </StackPanel>
           <StackPanel Grid.Column="2" HorizontalAlignment="Right">
            <Border Background="{Binding StatusBackground}" CornerRadius="6" Padding="10,4"><StackPanel Orientation="Horizontal"><Ellipse Fill="{Binding StatusBrush}" Width="6" Height="6" Margin="0,0,7,0"/><TextBlock Text="{Binding StatusLabel}" Foreground="{Binding StatusBrush}" FontSize="10" FontWeight="SemiBold"/></StackPanel></Border>
            <Button Content="Status page ↗" Tag="{Binding}" Click="OpenServiceClick" Margin="0,8,0,0" Padding="8,4" Background="Transparent" BorderBrush="Transparent" Foreground="#9AB8EC" FontSize="10"/>
            <Button Content="Remove" Tag="{Binding}" Click="RemoveServiceClick" Padding="8,2" Background="Transparent" BorderBrush="Transparent" Foreground="#71839F" FontSize="10"/>
           </StackPanel>
          </Grid>
         </Border>
        </DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </Grid>
     </Grid>

     <Grid x:Name="LibraryPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <TextBlock Text="{Binding CatalogCount, StringFormat={}{0} built-in and custom services. Select the ones you want to monitor.}" Foreground="#94A4BF" FontSize="13" Margin="0,0,0,18"/>
      <Grid Grid.Row="1" Margin="0,0,0,18"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <TextBox Text="{Binding Search, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search services" ToolTip="Search by service name or category" Margin="0,0,10,0"/>
       <ComboBox Grid.Column="1" ItemsSource="{Binding Categories}" SelectedItem="{Binding Category}" Margin="0,0,10,0" AutomationProperties.Name="Category"/>
       <Button Grid.Column="2" Content="+ Custom service" Click="CustomClick"/>
      </Grid>
      <ListBox Grid.Row="2" ItemsSource="{Binding LibraryView}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
       <ListBox.ItemTemplate><DataTemplate>
        <Border Style="{StaticResource Panel}" Padding="14,11">
         <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="32"/><ColumnDefinition Width="*"/><ColumnDefinition Width="160"/></Grid.ColumnDefinitions>
          <CheckBox IsChecked="{Binding IsWatched}" AutomationProperties.Name="{Binding Name}" VerticalAlignment="Center"/>
          <StackPanel Grid.Column="1"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="{Binding ProviderLabel}" Foreground="#71839F" FontSize="10" Margin="0,5,0,0"/></StackPanel>
          <TextBlock Grid.Column="2" Text="{Binding Category}" Foreground="#94A4BF" FontSize="11" HorizontalAlignment="Right" VerticalAlignment="Center"/>
         </Grid>
        </Border>
       </DataTemplate></ListBox.ItemTemplate>
      </ListBox>
     </Grid>

     <Grid x:Name="ActivityPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <DockPanel Margin="0,0,0,18"><Button DockPanel.Dock="Right" Content="Clear history" Click="ClearHistoryClick"/><TextBlock Text="Confirmed status changes, kept locally. Up to 300 events." Foreground="#94A4BF" FontSize="12" VerticalAlignment="Center"/></DockPanel>
      <Grid Grid.Row="1">
       <TextBlock Text="No alerts yet. Your confirmed status changes will appear here." Foreground="#94A4BF" Margin="20" Visibility="{Binding IsActivityEmpty, Converter={StaticResource BoolVisibility}}"/>
       <ListBox ItemsSource="{Binding Activity}" Background="Transparent" BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
        <ListBox.ItemTemplate><DataTemplate><Border Style="{StaticResource Panel}" Padding="18,15"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="16"/><ColumnDefinition Width="*"/><ColumnDefinition Width="128"/></Grid.ColumnDefinitions>
         <Ellipse Fill="{Binding Color}" Width="7" Height="7" VerticalAlignment="Top" Margin="0,5,0,0"/>
         <StackPanel Grid.Column="1" Margin="8,0,20,0"><TextBlock Text="{Binding Title}" FontSize="14" FontWeight="SemiBold"/><TextBlock Text="{Binding Message}" Foreground="#94A4BF" FontSize="12" Margin="0,8,0,0"/></StackPanel>
         <TextBlock Grid.Column="2" Text="{Binding Time}" Foreground="#71839F" FontSize="10" HorizontalAlignment="Right"/>
        </Grid></Border></DataTemplate></ListBox.ItemTemplate>
       </ListBox>
      </Grid>
     </Grid>

     <ScrollViewer x:Name="SettingsPage" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
      <StackPanel>
       <Border Style="{StaticResource Panel}" Margin="0,0,0,16"><StackPanel>
        <TextBlock Text="Windows &amp; monitoring" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,12"/>
        <CheckBox Content="Launch at Windows sign-in (in the system tray)" IsChecked="{Binding LaunchAtLogin}"/>
        <CheckBox Content="Start minimized when opened manually" IsChecked="{Binding StartMinimized}"/>
        <TextBlock Text="Keep the executable in a permanent folder before enabling startup." Foreground="#71839F" FontSize="11" Margin="0,0,0,16"/>
        <StackPanel Orientation="Horizontal"><TextBlock Text="Check every" VerticalAlignment="Center" Margin="0,0,12,0"/><TextBox Text="{Binding PollSeconds, UpdateSourceTrigger=LostFocus}" Width="85" AutomationProperties.Name="Polling interval"/><TextBlock Text="seconds (30–900)" Foreground="#94A4BF" VerticalAlignment="Center" Margin="12,0,0,0"/></StackPanel>
       </StackPanel></Border>
       <Border Style="{StaticResource Panel}" Margin="0,0,0,16"><StackPanel>
        <DockPanel><Button Content="Send test alert" DockPanel.Dock="Right" Click="TestNotificationClick"/><TextBlock Text="Alerts you want to receive" FontSize="18" FontWeight="SemiBold" VerticalAlignment="Center"/></DockPanel>
        <TextBlock Text="Windows notification settings and Do not disturb can silence banners." Foreground="#71839F" FontSize="11" Margin="0,10,0,12"/>
        <CheckBox Content="Service outages" IsChecked="{Binding NotifyOutage}"/>
        <CheckBox Content="Degraded performance and partial outages" IsChecked="{Binding NotifyDegraded}"/>
        <CheckBox Content="Recovery — back to normal" IsChecked="{Binding NotifyRecovery}"/>
        <CheckBox Content="Maintenance" IsChecked="{Binding NotifyMaintenance}"/>
        <CheckBox Content="Alert if a service is already affected on the first check" IsChecked="{Binding AlertOnFirstProblem}"/>
        <CheckBox Content="Play the Windows notification sound" IsChecked="{Binding NotificationSound}"/>
       </StackPanel></Border>
       <Border Style="{StaticResource Panel}"><StackPanel>
        <TextBlock Text="Your data stays here." FontSize="18" FontWeight="SemiBold"/>
        <TextBlock Text="No account, tracking, telemetry or central monitoring server. UptimeKite contacts the selected providers' public status APIs and stores your preferences and alert history in %LOCALAPPDATA%\UptimeKite." Foreground="#94A4BF" FontSize="12" Margin="0,12,0,0" LineHeight="20"/>
        <Button Content="Open local data folder" HorizontalAlignment="Left" Margin="0,14,0,0" Click="DataFolderClick"/>
       </StackPanel></Border>
      </StackPanel>
     </ScrollViewer>
    </Grid>
    <TextBlock Grid.Row="3" Text="PUBLIC PROVIDER REPORTS   ·   UNAVAILABLE ≠ OUTAGE   ·   CLOSE TO KEEP WATCHING" FontSize="9" Foreground="#60718E" Margin="0,16,0,0"/>
   </Grid>
  </Grid>
 </Grid>
 </Border>
</Window>
